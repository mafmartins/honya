{
  "name": "honya",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts/ffmpeg",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node scripts/build.mjs && electron .",
    "fetch:ffmpeg": "node scripts/ffmpeg/fetch.ts",
    "ffmpeg:pin": "node scripts/ffmpeg/fetch.ts --pin",
    "pack": "node scripts/ffmpeg/fetch.ts && node scripts/build.mjs && electron-builder"
  },
  "dependencies": {
    "ass-compiler": "0.1.16",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
